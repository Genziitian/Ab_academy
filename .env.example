# Akhand Bharat Academy — environment template
# Copy to apps/web/.env.local

# ---------------------------------------------------------------- Supabase
# Project Settings → API. Without these the web app and admin console run on
# in-memory mock data and show a "demo data" banner.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Bypasses RLS — never expose it to the browser and never prefix
# it with NEXT_PUBLIC_. Used by payment webhooks and background jobs.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional local Supabase (supabase start)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------- Site URL
# Origin Google is sent back to after consent. Set this in every deployed
# environment: it is preferred over the request Host header so a spoofed host
# cannot redirect the OAuth callback somewhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------ Google OAuth
# The hosted project reads its Google client id/secret from the dashboard
# (Authentication -> Providers -> Google), NOT from here. These two are only
# needed for the local stack (`supabase start`), which reads them from config.toml.
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# SUPABASE_AUTH_GOOGLE_SECRET=

# ----------------------------------------------- Edge Function secrets
# Set with `supabase secrets set`, not here. Listed for reference:
#   FCM_PROJECT_ID      Firebase project id
#   FCM_CLIENT_EMAIL    service account client_email
#   FCM_PRIVATE_KEY     service account private_key (keep the \n escapes)
